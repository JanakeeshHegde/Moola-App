# MOOLA Server — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ── MongoDB ──────────────────────────────────────────────────
# Local MongoDB fallback:
# MONGODB_URI=mongodb://localhost:27017/moola
# MongoDB Atlas (MOOLACluster):
# Replace <username> and <password> with your Atlas database user credentials.
# Note: URL-encode any special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@moolacluster.xxxxxx.mongodb.net/moola?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
# Generate cryptographically secure 256-bit keys via: npm run generate:jwt
JWT_ACCESS_SECRET=your_jwt_access_secret_256_bit_hex
JWT_REFRESH_SECRET=your_jwt_refresh_secret_256_bit_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Razorpay (Sandbox) ───────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=replace_with_webhook_secret

# ── Cloudinary (Image Storage) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Push Notifications (Expo Push Notification Service) ──────
# Expo Push Notifications is free and does not require credentials for standard volume.
# Optional Expo Access Token to increase rate limits:
EXPO_ACCESS_TOKEN=your_expo_access_token_optional
# Production Android (FCM V1) and iOS (APNs) credentials are configured through Expo/EAS CLI:
# Run: eas credentials (upload google-services.json / Apple push certificate)

# ── Shiprocket ───────────────────────────────────────────────
SHIPROCKET_EMAIL=your_shiprocket_email
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000,exp://192.168.1.x:8081

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ── Private Admin Provisioning ────────────────────────────────
# Comma-separated phone numbers permitted to hold administrator privileges.
# Admins are provisioned server-side using: npm run admin:provision
ADMIN_ALLOWED_PHONES=9000000000

