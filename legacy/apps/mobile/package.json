{
  "name": "@moola/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "MOOLA Mobile Application — React Native + Expo + TypeScript",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --host lan",
    "start:lan": "expo start --host lan",
    "start:tunnel": "expo start --tunnel",
