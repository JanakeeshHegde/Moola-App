<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moola_cream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerRequests"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:paddingHorizontal="@dimen/spacing_base"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackRequests"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/moola_charcoal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="My Product Requests"
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnNewRequestTop"
            app:layout_constraintStart_toEndOf="@+id/btnBackRequests"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewRequestTop"
            style="@style/Widget.MOOLA.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="+ Request"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Subtitle Banner -->
    <LinearLayout
        android:id="@+id/bannerRequestsInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFEBE4"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_base"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@+id/headerRequests">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reverse Marketplace — Direct from Makers"
            android:textColor="@color/moola_forest_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Can't find a rare homemade food item? Post your request and verified home makers will send comparable price quotes."
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbRequests"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bannerRequestsInfo" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_base"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bannerRequestsInfo" />

    <LinearLayout
        android:id="@+id/emptyRequestsState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_2xl"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bannerRequestsInfo">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Requests Posted Yet"
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Need homemade pickles, pure honey, or jackfruit crisps? Tell local makers what you need!"
            android:textAlignment="center"
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="@dimen/text_sm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEmptyNewRequest"
            style="@style/Widget.MOOLA.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="Post Product Request" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
