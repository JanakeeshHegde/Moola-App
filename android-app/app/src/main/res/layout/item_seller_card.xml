<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/moola_white"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="2dp"
    app:strokeColor="@color/moola_sandstone_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Avatar + Verification -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivSellerCardAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="#E8EFE9"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/logo_moola"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <ImageView
                android:id="@+id/ivSellerCardVerified"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/moola_forest_green" />
        </FrameLayout>

        <!-- Shop Name -->
        <TextView
            android:id="@+id/tvSellerCardShopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Artisan Kitchen"
            android:textColor="@color/moola_charcoal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Slug / Handle -->
        <TextView
            android:id="@+id/tvSellerCardSlug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@maker"
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="11sp" />

        <!-- Ratings & Followers -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_star"
                app:tint="@color/moola_warm_gold" />

            <TextView
                android:id="@+id/tvSellerCardRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="4.9"
                android:textColor="@color/moola_charcoal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text="•"
                android:textColor="@color/moola_charcoal_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSellerCardFollowers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="140 followers"
                android:textColor="@color/moola_charcoal_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Description snippet -->
        <TextView
            android:id="@+id/tvSellerCardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:minLines="2"
            android:text="Authentic regional homemade delicacies prepared fresh upon order placement."
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="11sp" />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSellerCardVisit"
            style="@style/Widget.MOOLA.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="10dp"
            android:text="Visit Kitchen"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
