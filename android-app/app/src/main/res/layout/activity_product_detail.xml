<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moola_cream">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:background="@color/moola_cream"
        android:paddingHorizontal="@dimen/spacing_base"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/moola_charcoal" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Product Details"
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_2xl">

            <!-- Product Image Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@color/moola_cream_surface">

                <ImageView
                    android:id="@+id/ivDetailProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Product Image"
                    android:scaleType="centerCrop" />

                <!-- Badges over image -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/spacing_base"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailOrganicBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_organic"
                        android:text="100% ORGANIC"
                        android:textColor="@color/moola_forest_green"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailCertifiedBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:background="@drawable/bg_tag_artisan"
                        android:text="PGS CERTIFIED"
                        android:textColor="@color/moola_terracotta"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Product Info Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_base">

                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOMEMADE CHIPS &amp; CRISPS"
                    android:textColor="@color/moola_terracotta"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Malnad Raw Jackfruit Chips (Halasina Chips)"
                    android:textColor="@color/moola_charcoal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Price and Quantity Selector -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md">

                    <LinearLayout
                        android:id="@+id/priceContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tvDetailPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹180"
                            android:textColor="@color/moola_forest_green"
                            android:textSize="26sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailMrp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_sm"
                            android:text="₹220"
                            android:textColor="@color/moola_charcoal_muted"
                            android:textSize="@dimen/text_base" />

                        <TextView
                            android:id="@+id/tvDetailUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:text="/ 250g"
                            android:textColor="@color/moola_charcoal_secondary"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <!-- Quantity Stepper -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_search_bar"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/spacing_xs"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageButton
                            android:id="@+id/btnQtyMinus"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Minus"
                            android:src="@drawable/ic_minus"
                            app:tint="@color/moola_forest_green" />

                        <TextView
                            android:id="@+id/tvQtyValue"
                            android:layout_width="28dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/moola_charcoal"
                            android:textSize="@dimen/text_base"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnQtyPlus"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Plus"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/moola_forest_green" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Seller Profile Trust Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSellerInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    app:cardBackgroundColor="@color/moola_white"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/moola_sandstone_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_base">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/seller_verification_label"
                            android:textColor="@color/moola_forest_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailSellerShop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Lakshmi Homemade Pickles &amp; Chips"
                            android:textColor="@color/moola_charcoal"
                            android:textSize="@dimen/text_base"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailSellerDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:text="Western Ghats verified artisan maker. Fresh batches prepared upon order confirmation."
                            android:textColor="@color/moola_charcoal_secondary"
                            android:textSize="@dimen/text_sm" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDetailOpenShop"
                                style="@style/Widget.MOOLA.Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="@dimen/spacing_xs"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="🏪 View Shop" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDetailChatMaker"
                                style="@style/Widget.MOOLA.Button.Secondary"
                                android:layout_width="0dp"
                                android:layout_height="38dp"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:text="💬 Message Maker" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description & Origin Details -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="About This Product"
                    android:textColor="@color/moola_charcoal"
                    android:textSize="@dimen/text_md"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:lineSpacingExtra="3dp"
                    android:text="Authentic crispy jackfruit chips freshly prepared in pure wood-pressed coconut oil with natural rock salt. Sourced from wild Malnad jackfruits. No palm oil, zero chemical preservatives."
                    android:textColor="@color/moola_charcoal_secondary"
                    android:textSize="@dimen/text_base" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar (WhatsApp Enquiry & Order Request) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/moola_white"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_base"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWhatsAppEnquiry"
            style="@style/Widget.MOOLA.Button.WhatsApp"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/btn_whatsapp_enquiry"
            app:icon="@drawable/ic_whatsapp"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOrderNow"
            style="@style/Widget.MOOLA.Button"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height"
            android:layout_weight="1"
            android:text="@string/btn_order_now" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressBarDetail"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="@color/moola_forest_green"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
