<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moola_cream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerChat"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:paddingHorizontal="@dimen/spacing_base"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/moola_charcoal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBackChat"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Kodagu Forest Honey"
                android:textColor="@color/moola_charcoal"
                android:textSize="@dimen/text_base"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Direct Maker Messaging • Real-time"
                android:textColor="@color/moola_forest_green"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Context Reference Banner -->
    <LinearLayout
        android:id="@+id/chatContextBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFEBE4"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_base"
        android:paddingVertical="@dimen/spacing_xs"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/headerChat">

        <TextView
            android:id="@+id/tvChatContextText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Referencing Order #ORD-849201"
            android:textColor="@color/moola_charcoal"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/chatInputContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chatContextBanner" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_base"
        app:layout_constraintBottom_toTopOf="@+id/chatInputContainer"
        app:layout_constraintTop_toBottomOf="@+id/chatContextBanner" />

    <!-- Chat input bar -->
    <LinearLayout
        android:id="@+id/chatInputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/moola_white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_base"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:hint="Type message to maker..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="10dp"
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_base" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendMessage"
            style="@style/Widget.MOOLA.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Send" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
