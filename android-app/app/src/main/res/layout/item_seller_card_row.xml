<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_base"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/moola_white"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="1dp"
    app:strokeColor="@color/moola_sandstone_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivRowAvatar"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#E8EFE9"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo_moola"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

                <ImageView
                    android:id="@+id/ivRowVerified"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/moola_forest_green" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRowShopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Artisan Kitchen"
                    android:textColor="@color/moola_charcoal"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRowSlug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@maker"
                    android:textColor="@color/moola_charcoal_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/moola_warm_gold" />

                    <TextView
                        android:id="@+id/tvRowRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="4.9"
                        android:textColor="@color/moola_charcoal"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:text="•"
                        android:textColor="@color/moola_charcoal_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvRowFollowers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="140 followers"
                        android:textColor="@color/moola_charcoal_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRowVisit"
                style="@style/Widget.MOOLA.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Visit Shop"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRowDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="Authentic regional homemade delicacies prepared fresh upon order placement."
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="12sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
