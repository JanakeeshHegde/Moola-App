<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/moola_white"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="1dp"
    app:strokeColor="@color/moola_sandstone_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_base">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBoardCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HOMEMADE PANTRY"
                android:textColor="@color/moola_terracotta"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBoardBuyerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buyer: Arjun S."
                android:textColor="@color/moola_charcoal_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBoardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="5 kg Pure Homemade Organic Sugarcane Jaggery"
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_base"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBoardQuantityAndBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Required: 5 kg • Buyer Budget: ₹450"
            android:textColor="@color/moola_forest_green"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBoardLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Delivery to: Indiranagar, Bengaluru"
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/tvBoardDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Looking for chemical-free traditional jaggery from Mandya/Malnad."
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBoardChat"
                style="@style/Widget.MOOLA.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="Chat with Buyer"
                app:icon="@drawable/ic_chat"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBoardSubmitOffer"
                style="@style/Widget.MOOLA.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Send Offer Quote" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
