<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moola_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_3xl">

            <!-- App Bar / Header -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_base"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_sm">

                <LinearLayout
                    android:id="@+id/brandLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="MOOLA Brand Logo"
                        android:src="@drawable/logo_moola" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:letterSpacing="0.08"
                        android:text="MOOLA"
                        android:textColor="@color/moola_primary_brown"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Notifications button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnHeaderNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    app:cardBackgroundColor="@color/moola_white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnHeaderMessages"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/moola_sandstone_border"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_orders"
                            app:tint="@color/moola_forest_green" />

                        <View
                            android:id="@+id/viewNotificationBadge"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_tag_organic"
                            android:backgroundTint="@color/moola_terracotta"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Messages button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnHeaderMessages"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    app:cardBackgroundColor="@color/moola_white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnHeaderProfile"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/moola_sandstone_border"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/moola_forest_green" />

                        <View
                            android:id="@+id/viewChatBadge"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="6dp"
                            android:background="@drawable/bg_tag_organic"
                            android:backgroundTint="@color/moola_terracotta"
                            android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Profile avatar button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnHeaderProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="@color/moola_white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeColor="@color/moola_sandstone_border"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/moola_forest_green" />
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Search Bar Entry Point -->
            <LinearLayout
                android:id="@+id/searchEntryBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginHorizontal="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_search_bar"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_base">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/moola_charcoal_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/home_search_placeholder"
                    android:textColor="@color/moola_charcoal_muted"
                    android:textSize="@dimen/text_sm" />
            </LinearLayout>

            <!-- Editorial Hero Section -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_base"
                app:cardBackgroundColor="@color/moola_forest_green"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_organic"
                        android:text="ARTISANAL FOOD MARKETPLACE"
                        android:textColor="@color/moola_cream"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/home_hero_title"
                        android:textColor="@color/moola_white"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:text="@string/home_hero_subtitle"
                        android:textColor="#DDE5DC"
                        android:textSize="@dimen/text_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHeroCta"
                        style="@style/Widget.MOOLA.Button.Accent"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:paddingHorizontal="@dimen/spacing_lg"
                        android:text="@string/home_hero_cta"
                        android:textSize="@dimen/text_sm" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 1. Primary Profile-First Discovery: Artisan Makers & Village Kitchens -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/spacing_base">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Artisan Makers &amp; Kitchens"
                            android:textColor="@color/moola_charcoal"
                            android:textSize="@dimen/text_lg"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Discover verified family recipes and small-batch makers"
                            android:textColor="@color/moola_charcoal_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvViewAllSellers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_all"
                        android:textColor="@color/moola_forest_green"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <ProgressBar
                    android:id="@+id/pbSellers"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/spacing_base"
                    android:indeterminateTint="@color/moola_forest_green"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSellers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_base" />
            </LinearLayout>

            <!-- Feature Banners: Seasonal Pre-Booking & Custom Requests -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_base"
                android:layout_marginTop="@dimen/spacing_md"
                android:orientation="vertical">

                <!-- Seasonal Pre-Booking Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSeasonalEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:cardBackgroundColor="#F5EFE6"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/moola_terracotta"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_seasonal"
                                app:tint="@color/moola_terracotta" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:layout_weight="1"
                                android:text="SEASONAL &amp; FESTIVAL PRE-BOOKING"
                                android:textColor="@color/moola_terracotta"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_organic"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="LIMITED"
                                android:textColor="@color/moola_forest_green"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Fresh Wild Forest Honey &amp; Festival Sweets"
                            android:textColor="@color/moola_charcoal"
                            android:textSize="@dimen/text_base"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Reserve verified small-batch harvest allocations before capacity sells out."
                            android:textColor="@color/moola_charcoal_secondary"
                            android:textSize="@dimen/text_sm" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenSeasonalHub"
                            style="@style/Widget.MOOLA.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="View Seasonal Campaigns"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Reverse Marketplace Request Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCustomRequestEntry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/moola_white"
                    app:cardCornerRadius="@dimen/radius_md"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/moola_sandstone_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_md">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_requests"
                                app:tint="@color/moola_forest_green" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xs"
                                android:layout_weight="1"
                                android:text="REVERSE MARKETPLACE"
                                android:textColor="@color/moola_forest_green"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_artisan"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="BUYER DEMAND"
                                android:textColor="@color/moola_terracotta"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Can't find a specific homemade delicacy?"
                            android:textColor="@color/moola_charcoal"
                            android:textSize="@dimen/text_base"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Post a custom product request and receive direct offers from verified makers across India."
                            android:textColor="@color/moola_charcoal_secondary"
                            android:textSize="@dimen/text_sm" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenCustomRequests"
                            style="@style/Widget.MOOLA.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="My Requests &amp; Offers"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Categories Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_base"
                    android:text="@string/section_categories"
                    android:textColor="@color/moola_charcoal"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_base" />
            </LinearLayout>

            <!-- Featured Artisanal Specialties Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/spacing_base">

                    <TextView
                        android:id="@+id/tvFeaturedHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_featured"
                        android:textColor="@color/moola_charcoal"
                        android:textSize="@dimen/text_lg"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvViewAllFeatured"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/view_all"
                        android:textColor="@color/moola_forest_green"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <ProgressBar
                    android:id="@+id/pbFeatured"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/spacing_base"
                    android:indeterminateTint="@color/moola_forest_green"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFeaturedProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_base" />
            </LinearLayout>

            <!-- Freshly Made Batches / New Arrivals Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_base"
                    android:text="@string/section_new_arrivals"
                    android:textColor="@color/moola_charcoal"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNewArrivals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="@dimen/spacing_base" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
