<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moola_cream">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerSellerBoard"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:paddingHorizontal="@dimen/spacing_base"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackSellerBoard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/moola_charcoal" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="Buyer Requests Board"
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/btnBackSellerBoard"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/bannerBoardInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFEBE4"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_base"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintTop_toBottomOf="@+id/headerSellerBoard">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Direct Customer Demand • Zero Intermediaries"
            android:textColor="@color/moola_forest_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Review requests for homemade foods from pan-India buyers. Submit your price and delivery quote to secure orders."
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pbSellerBoard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bannerBoardInfo" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSellerBoardRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_base"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bannerBoardInfo" />

    <TextView
        android:id="@+id/tvEmptyBoard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/spacing_xl"
        android:text="No open buyer requests at the moment.\nCheck back soon for new demand!"
        android:textColor="@color/moola_charcoal_secondary"
        android:textSize="@dimen/text_base"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bannerBoardInfo" />

</androidx.constraintlayout.widget.ConstraintLayout>
