<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bg_tag_artisan"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/tvOtherSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ramesh Kumar (Maker)"
            android:textColor="@color/moola_terracotta"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOtherMessageContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="We pack this batch tomorrow morning and hand it directly to Speed Post."
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_base" />

        <TextView
            android:id="@+id/tvOtherMessageTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="2dp"
            android:text="11:45 AM"
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
