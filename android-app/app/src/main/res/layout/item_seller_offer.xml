<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/moola_white"
    app:cardCornerRadius="@dimen/radius_md"
    app:cardElevation="1dp"
    app:strokeColor="@color/moola_sandstone_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_base">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOfferShopName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kodagu Forest Honey &amp; Spices"
                    android:textColor="@color/moola_charcoal"
                    android:textSize="@dimen/text_base"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOfferSellerRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="4.9 ★ Verified Maker"
                    android:textColor="@color/moola_forest_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOfferPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹425"
                android:textColor="@color/moola_terracotta"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOfferEstimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="Delivery Estimate: Ready in 3 days • Direct Speed Post"
            android:textColor="@color/moola_charcoal_secondary"
            android:textSize="@dimen/text_sm" />

        <TextView
            android:id="@+id/tvOfferMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="#F9F6F0"
            android:padding="8dp"
            android:text="“We prepare unbleached jaggery blocks directly on our organic farm in Kodagu. Can dispatch within 48 hours via Speed Post.”"
            android:textColor="@color/moola_charcoal"
            android:textSize="@dimen/text_sm"
            android:textStyle="italic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfferChat"
                style="@style/Widget.MOOLA.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:text="Chat with Maker"
                app:icon="@drawable/ic_chat"
                app:iconSize="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOfferAccept"
                style="@style/Widget.MOOLA.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Accept &amp; Order" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
