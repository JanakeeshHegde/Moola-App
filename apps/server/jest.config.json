{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/__tests__/**/*.test.ts", "**/*.test.ts"],
  "moduleNameMapper": {
    "@moola/shared": "<rootDir>/../../packages/shared/src/index.ts"
  },
  "setupFiles": ["<rootDir>/src/tests/setup.ts"],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/scripts/**",
    "!src/tests/**"
  ],
  "coverageDirectory": "coverage",
  "testTimeout": 30000
}
