# MOOLA Spring Boot Backend - Environment Variables Template
# Copy this file to .env or set environment variables in your PowerShell session
# IMPORTANT: Never commit actual database passwords or production secrets to Git!

# Server Port (Default: 5000)
SERVER_PORT=5000

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-host>/moola?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/moola?retryWrites=true&w=majority

# JWT 256-bit Secret Key (Must be at least 32 characters/256 bits)
JWT_SECRET=your-secure-random-256-bit-hex-secret-key-at-least-32-chars

# JWT Token Expiration in milliseconds (15 minutes = 900000)
JWT_EXPIRATION_MS=900000

# JWT Refresh Token Expiration in milliseconds (7 days = 604800000)
JWT_REFRESH_EXPIRATION_MS=604800000

# Admin Allowed Phone Numbers (comma-separated, 10 digits without country code)
ADMIN_ALLOWED_PHONES=9000000000
