{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@moola/shared": [
        "packages/shared/src/index.ts",
        "packages/shared/dist/index.d.ts"
      ],
      "@moola/shared/*": [
        "packages/shared/src/*",
        "packages/shared/dist/*"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".expo"
  ]
}
